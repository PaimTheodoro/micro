{
    "name": "psf/framework",
    "description": "Framework PHP para desenvolvimento de APIs",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Theodoro Paim",
            "email": "theodoro@porglin.com"
        }
    ],
    "minimum-stability": "dev",
    "require": {
        "jenssegers/agent": "^2.6",
        "aws/aws-sdk-php": "^3.270",
        "spatie/ignition": "^1.11"
    },
    "autoload": {
        "files": [
            "settings.php"
        ],
        "psr-4": {
            "Psf\\": "src/",
            "Psf\\Database\\": "src/database/",
            "Psf\\Model\\": "src/model/",
            "Psf\\Api\\": "src/api/",
            "Psf\\Helper\\": "src/helpers/",
            "Psf\\Http\\": "src/http/",
            "Psf\\Utils\\": "src/utils/",
            "Psf\\Enumerators\\": "src/enum/"
        }
    },
    "bin": [
        "bin/phinx"
    ],
    "require-dev": {
        "robmorgan/phinx": "0.x-dev"
    }
}
