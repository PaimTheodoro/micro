{
    "name": "psf/framework",
    "description": "Framework PHP para desenvolvimento de APIs",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Theodoro Paim",
            "email": "theodoro@porglin.com"
        }
    ],
    "minimum-stability": "stable",
    "require": {
        "php": ">=8.1",
        "ext-pdo": "*",
        "jenssegers/agent": "^2.6",
        "spatie/ignition": "^1.11"
    },
    "autoload": {
        "files": [
            "settings.php"
        ],
        "psr-4": {
            "Psf\\": "src/",
            "Psf\\Database\\": "src/database/",
            "Psf\\Model\\": "src/model/",
            "Psf\\Helper\\": "src/helpers/",
            "Psf\\Http\\": "src/http/",
            "Psf\\Monitor\\": "src/monitor/",
            "Psf\\Utils\\": "src/utils/",
            "Psf\\Enumerators\\": "src/enum/",
            "Psf\\Model\\Attributes\\": "src/model/attributes/"
        }
    },
    "bin": [
        "bin/phinx",
        "bin/psf"
    ],
    "require-dev": {
        "robmorgan/phinx": "^0.16",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "prefer-stable": true,
    "suggest": {
        "ext-apcu": "Cache de rotas e de metadados dos models entre requisições",
        "ext-curl": "Necessário para Psf\\Http\\Http::request e Psf\\Http\\Request",
        "aws/aws-sdk-php": "Necessário para Psf\\Utils\\CloudStorage (Cloudflare R2)",
        "robmorgan/phinx": "Necessário para o comando bin/psf (migrations) em projetos consumidores"
    },
    "scripts": {
        "test": "pest",
        "test:unit": "pest --testsuite=Unit",
        "test:integration": "pest --testsuite=Integration",
        "test:drivers": [
            "Composer\\Config::disableProcessTimeout",
            "@putenv PSF_DRIVERS=1",
            "pest --testsuite=Drivers"
        ],
        "analyse": "phpstan analyse --memory-limit=512M"
    }
}
