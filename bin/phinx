#!/usr/bin/env php
<?php

// bin/phinx - Adaptador para carregar o ambiente da aplicação antes de rodar o Phinx.

(function () {
    // Tenta encontrar o autoloader do Composer subindo a árvore de diretórios
    $autoloaderPath = '/vendor/autoload.php';
    $dir = __DIR__;
    // Pelo proxy do Composer (vendor/bin/psf) o autoloader do projeto vem em $_composer_autoload_path.
    // Necessário quando o pacote é um symlink (repositório `path`): __DIR__ aponta para o checkout real.
    $composerAutoload = $GLOBALS['_composer_autoload_path'] ?? null;
    if (is_string($composerAutoload) && is_file($composerAutoload)) {
        $dir = dirname(realpath($composerAutoload), 2);
    }
    while (!file_exists($dir . $autoloaderPath)) {
        if ($dir === dirname($dir)) { // Chegou na raiz do sistema
            echo "Erro: Não foi possível encontrar o autoloader do Composer. Certifique-se de que o Phinx está sendo executado a partir de um projeto com Composer.\n";
            exit(1);
        }
        $dir = dirname($dir);
    }
    
    $autoloader = require $dir . $autoloaderPath;

    // Raiz do projeto consumidor para os comandos (migrations, seeds, models gerados).
    // O ROOT do settings.php não serve aqui: no CLI ele aponta para o diretório do framework
    // (vendor/psf/framework). Fica definido antes de carregar a config do projeto.
    if (!defined('PSF_PROJECT_ROOT')) {
        define('PSF_PROJECT_ROOT', $dir);
    }

    // Compatibilidade: ROOT só é definido aqui se ainda não existir
    if (!defined('ROOT')) {
        define('ROOT', $dir);
    }

    // Agora que temos o autoloader, a raiz do projeto consumidor é $dir.
    // Procuramos por um arquivo de inicialização do framework.
    // O projeto que usa o framework deve fornecer um desses arquivos na sua raiz.
    $bootstrapFiles = ['bootstrap/app.php', 'config/bootstrap.php', 'bootstrap.php', 'config.php'];
    $bootstrapLoaded = false;
    $config = null;
    $home = null;
    
    foreach ($bootstrapFiles as $file) {
        if (file_exists($dir . '/' . $file)) {
            $config = $dir . '/' . $file;
            $home = $dir;
            $bootstrapLoaded = true;
            break;
        }
    }

    if (!$bootstrapLoaded) {
        echo "Erro: Não foi possível encontrar um arquivo de inicialização (ex: bootstrap.php, config.php).\n";
        echo "O projeto que utiliza este framework deve fornecer um arquivo de inicialização para carregar as configurações.\n";
        exit(1);
    }

    // Inicializa o framework PSF com as configurações carregadas
    if (class_exists('PSF')) {
        PSF::init(['config' => $config]);
    } else {
        echo "Erro: Classe PSF não encontrada. Certifique-se de que o framework está instalado corretamente.\n";
        exit(1);
    }

    // Arquivo de configuração do Phinx do framework (caminho absoluto). A constante é mantida
    // por compatibilidade, mas o Phinx não a lê: o padrão de --configuration é definido abaixo.
    $frameworkDir = dirname(__DIR__); // Raiz do nosso pacote de framework
    define('PHINX_CONFIG_FILE', $frameworkDir . '/phinx.php');

    // Carrega e executa a aplicação CLI do Phinx do projeto principal
    $phinxBin = $home . '/vendor/robmorgan/phinx/bin/phinx';
    $phinxApp = $home . '/vendor/robmorgan/phinx/app/phinx.php';
    if (!file_exists($phinxBin)) {
        echo "Erro: robmorgan/phinx não está instalado neste projeto.\n";
        echo "Instale com: composer require robmorgan/phinx\n";
        exit(1);
    }

    if (file_exists($phinxApp)) {
        // O Phinx não registra comandos customizados via configuração: instanciamos a aplicação
        // e adicionamos os comandos do PSF antes de executar.
        $app = require $phinxApp;

        // O Phinx só procura phinx.* no diretório atual. Sem config própria ali, usa a do
        // framework (que lê config['db']); `-c arquivo` continua valendo.
        $defaultConfig = \Psf\Database\PhinxCli::defaultConfigFile((string) getcwd(), PHINX_CONFIG_FILE);
        if ($defaultConfig !== null) {
            \Psf\Database\PhinxCli::applyDefaultConfig($app, $defaultConfig);
        }

        $app->addCommands([
            new \Psf\Database\Command\ModelAwareMigration(),
            new \Psf\Database\Command\ModelGenerator(),
            new \Psf\Database\Command\TableAnalyzer(),
            new \Psf\Monitor\Command\MonitorInstall(),
            new \Psf\Monitor\Command\MonitorStatus(),
            new \Psf\Monitor\Command\MonitorPrune(),
            new \Psf\Monitor\Command\MonitorRollup(),
            new \Psf\Monitor\Command\MonitorMaintain(),
        ]);
        $app->run();
    } else {
        // Versões antigas do Phinx: executa o binário padrão (sem os comandos do PSF)
        require_once $phinxBin;
    }
})(); 