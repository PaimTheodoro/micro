</head>
<body>
    <noscript><p>JavaScript desabilitado!</p></noscript>
    <div class="container-fluid">
        <div class="row">
            <div class="col headerDocs">Documentação da API</div>
        </div>
        <div class="row">
            <div class="col-auto sidebar">
                <div class="row">
                    <div class="col searchBar"></div>
                </div>
                <div class="row">
                    <div class="col contentRequestList"></div>
                </div>
            </div>
            <div class="col contentFinal">
                <?php foreach ($requests as $request): ?>
                    <?php
                    $url = $request['uri'];
                    preg_match_all('/{([^:]+):([^}]+)}/', $request['uri'], $matches);
                    if (!empty($matches[1])) {
                        foreach ($matches[1] as $key => $match) {
                            $url = str_replace("{" . $match . ":" . $matches[2][$key] . "}", ":" . $match, $request['uri']);
                        }
                    }
                    ?>
                    <div class="row">
                        <div class="col itemRequest">
                            <div class="row">
                                <div class="col docReal">
                                    <div class="row">
                                        <div class="col name"><?= htmlspecialchars($request['title']) ?></div>
                                        <div class="col-auto contentType">
                                            <?php
                                            if (!isset($request['contentType']) || empty($request['contentType'])) {
                                                echo 'Without Content';
                                            } else {
                                                echo htmlspecialchars($request['contentType'] === 'json' ? 'application/json' : ($request['contentType'] === 'form-data' ? 'multipart/form-data' : $request['contentType']));
                                            }
                                            ?>
                                        </div>
                                    </div>

                                    <?php if (isset($request['description']) && !empty($request['description'])): ?>
                                        <div class="row">
                                            <div class="col description"><?= $request['description'] ?></div>
                                        </div>
                                    <?php endif; ?>

                                    <div class="row">
                                        <div class="col uri">
                                            <div class="row">
                                                <div class="col-auto methodLabel <?= strtolower(htmlspecialchars($request['method'])) ?>"><?= htmlspecialchars($request['method']) ?></div>
                                                <div class="col final">v<?= htmlspecialchars($request['version']) ?>/<?= htmlspecialchars($url) ?></div>
                                                <div class="col-auto iconCopy"><i class="fal fa-copy"></i></div>
                                            </div>
                                        </div>
                                    </div>

                                    <?php if ($request['protected']): ?>
                                        <div class="row">
                                            <div class="col authConfig">
                                                <div class="row"><div class="col titleSect">Autenticação</div></div>
                                                <div class="row">
                                                    <div class="col authType">
                                                        <div class="row">
                                                            <div class="col-auto icon"><i class="far fa-lock-alt"></i></div>
                                                            <div class="col-auto text">
                                                                <?php
                                                                if (!isset($request['authentication']) || empty($request['authentication'])) {
                                                                    echo 'Esse endpoint requer autenticação';
                                                                } else {
                                                                    $authTypes = array_map(function ($itemAuth) {
                                                                        $type = strtolower($itemAuth);
                                                                        if ($type === 'bearer') return '<span>Bearer Token</span>';
                                                                        if ($type === 'basic') return '<span>Basic Auth</span>';
                                                                        return '<span>' . htmlspecialchars($itemAuth) . '</span>';
                                                                    }, explode('/', $request['authentication']));
                                                                    echo 'Esse endpoint requer autenticação com ' . implode(' ou ', $authTypes);
                                                                }
                                                                ?>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <?php endif; ?>

                                    <?php if (isset($request['fields']) && count($request['fields']) > 0): ?>
                                        <div class="row">
                                            <div class="col paramnsList">
                                                <div class="row"><div class="col titleSect">Parâmetros</div></div>
                                                <div class="row">
                                                    <div class="col finalList">
                                                        <?php
                                                        $groupedFields = ['urlcomponent' => '', 'urlparam' => '', 'body' => ''];
                                                        foreach ($request['fields'] as $field) {
                                                            ob_start();
                                                            include __DIR__ . '/docFieldTemplate.phtml';
                                                            $groupedFields[$field['location']] .= ob_get_clean();
                                                        }
                                                        
                                                        if (!empty($groupedFields['urlcomponent'])) {
                                                            echo '<div class="row"><div class="col headerItem">Componentes da URL</div></div>' . $groupedFields['urlcomponent'];
                                                        }
                                                        if (!empty($groupedFields['urlparam'])) {
                                                            echo '<div class="row"><div class="col headerItem">Parametros na URL</div></div>' . $groupedFields['urlparam'];
                                                        }
                                                        if (!empty($groupedFields['body'])) {
                                                            echo '<div class="row"><div class="col headerItem">Parametros no Corpo da Requisição</div></div>' . $groupedFields['body'];
                                                        }
                                                        ?>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <?php endif; ?>
                                </div>
                                <div class="col-auto requestPlayground">Playground</div>
                            </div>
                        </div>
                    </div>
                <?php endforeach; ?>
            </div>
        </div>
    </div>
    <script src="https://cdn.porglin.com/js/jquery/jquery.min.js"></script>
    <script src="https://cdn.porglin.com/js/bootstrap/bootstrap.min.js"></script>
    <script src="https://cdn.porglin.com/js/sweetalert/sweetalert.min.js"></script>
    <script src="https://cdn.porglin.com/js/pg/pg.js"></script>
    <script>
        $(document).on("click", ".itemRequest .docReal .uri .iconCopy", function(){
            var getUrl = $(this).closest(".uri").find(".final").text().trim();
            pg.copyToClipboard(getUrl);
            swal("URL Copiada!", "A URL da requisição foi copiada para área de transferência", "success", {
                buttons: false,
                closeOnClickOutside: false,
                closeOnEsc: false,
                timer: 2500
            });
        });
    </script>
</body>
</html> 