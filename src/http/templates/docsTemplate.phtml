        .itemRequest .docReal .paramnsList .finalList .itemFinal .requiredField{ padding: 0px; margin-left: 12.5px; margin-top: 15px; font-size: 0.7rem; font-weight: 600; color: red; line-height: 25px; height: 25px; }
        .itemRequest .docReal .paramnsList .finalList .itemFinal .childList{ border-left: 3px solid #eee; margin-left: 15px; margin-top: 15px; border-top: 1px dashed #ddd; border-top-left-radius: 5px; border-bottom-left-radius: 5px; }
        .itemRequest .docReal .paramnsList .finalList .itemFinal .childList .childItem{ padding-bottom: 7.5px; border-bottom: 1px dashed #ddd; }
