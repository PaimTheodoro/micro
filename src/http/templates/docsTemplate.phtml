    <script src="https://cdn.jsdelivr.net/npm/json-formatter-js@2.3.4/dist/json-formatter.umd.js"></script>
    <script>
        $(document).on("click", ".itemRequest .docReal .uri .iconCopy", function(){
            var getUrl = $(this).closest(".uri").find(".final").text().trim();
            pg.copyToClipboard(getUrl);
            swal("URL Copiada!", "A URL da requisição foi copiada para área de transferência", "success", {
                buttons: false,
                closeOnClickOutside: false,
                closeOnEsc: false,
                timer: 2500
            });
        });

        // Base URL e Token globais (header), persistidos no navegador e replicados pra todos os Playgrounds.
        (function(){
            var defaultBaseUrl = <?= json_encode($baseUrl ?? '', JSON_HEX_TAG | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_HEX_AMP) ?>;
            var savedBaseUrl = localStorage.getItem("docsBaseUrl");

            $("#globalBaseUrl").val(savedBaseUrl !== null ? savedBaseUrl : defaultBaseUrl);
            $("#globalToken").val(localStorage.getItem("docsToken") || "");

            $("#globalBaseUrl").on("change", function(){ localStorage.setItem("docsBaseUrl", $(this).val().trim()); });
            $("#globalToken").on("change", function(){ localStorage.setItem("docsToken", $(this).val().trim()); });
        })();

        // O CSS de stretch depende do .row do bootstrap deles ser flex — nem sempre é.
        // Garante a altura do Playground igual à do conteúdo do endpoint medindo em JS.
        function syncPlaygroundHeights(){
            $(".itemRequest .requestRow").each(function(){
                var $docReal = $(this).find(".docReal");
                var $playground = $(this).find(".requestPlayground");
                $playground.css("height", $docReal.outerHeight() + "px");
            });
        }
        $(window).on("load resize", syncPlaygroundHeights);
        setTimeout(syncPlaygroundHeights, 300); // depois de fontes/ícones carregarem e ajustarem o layout

        // Busca client-side: filtra a lista lateral e os cards pelo título/uri.
        $("#docsSearch").on("keyup", function(){
            var term = $(this).val().trim().toLowerCase();
            $(".navItem").each(function(){
                $(this).toggle(!term || $(this).data("search").indexOf(term) !== -1);
            });
            $(".itemRequest").each(function(){
                $(this).toggle(!term || $(this).data("search").indexOf(term) !== -1);
            });
        });

        // Monta URL/método/headers/body a partir do form do Playground (usado pro envio real e pro "Copiar cURL").
        function buildPlaygroundRequest($form){
            var baseUrl = $("#globalBaseUrl").val().trim().replace(/\/$/, "");
            var method = $form.data("method");
            var uri = $form.data("uri");
            var version = $form.data("version");
            var protectedRoute = $form.data("protected") === 1 || $form.data("protected") === "1";

            var query = [];
            var body = {};
            var hasBody = false;
            var invalidJson = null;

            $form.find("input[data-location], textarea[data-location]").each(function(){
                var $field = $(this);
                var location = $field.data("location");
                var name = $field.attr("name");
                var value = $field.val();

                if (location === "urlcomponent") {
                    uri = uri.replace(new RegExp("\\{" + name + "(:[^}]+)?\\}"), encodeURIComponent(value));
                } else if (location === "urlparam") {
                    if (value !== "") query.push(encodeURIComponent(name) + "=" + encodeURIComponent(value));
                } else if (location === "body") {
                    hasBody = true;
                    try { body = JSON.parse(value || "{}"); }
                    catch(err) { invalidJson = err.message; }
                }
            });

            var url = baseUrl + "/v" + version + "/" + uri + (query.length ? "?" + query.join("&") : "");
            var headers = { "Content-Type": "application/json" };
            var token = $("#globalToken").val().trim();
            if (protectedRoute && token) {
                headers["Authorization"] = "Bearer " + token;
            }

            return {
                url: url,
                method: method,
                headers: headers,
                body: body,
                hasBody: hasBody && method !== "GET" && method !== "DELETE",
                invalidJson: invalidJson,
            };
        }

        // Gera um comando cURL (bash) equivalente ao request montado.
        function buildCurlCommand(req){
            var escapeSingleQuotes = function(str){ return String(str).replace(/'/g, "'\\''"); };
            var parts = ["curl -X " + req.method, "'" + escapeSingleQuotes(req.url) + "'"];

            Object.keys(req.headers).forEach(function(key){
                parts.push("-H '" + escapeSingleQuotes(key + ": " + req.headers[key]) + "'");
            });

            if (req.hasBody) {
                parts.push("-d '" + escapeSingleQuotes(JSON.stringify(req.body)) + "'");
            }

            return parts.join(" \\\n  ");
        }

        // Playground: monta a URL real (path/query/body) e dispara a requisição.
        $(document).on("submit", ".playgroundForm", function(e){
            e.preventDefault();
            var $form = $(this);
            var $responseBox = $form.closest(".requestPlayground").find(".responseBox");
            var req = buildPlaygroundRequest($form);

            if (req.invalidJson) {
                $responseBox.show().empty().append($("<pre>").text("JSON inválido no corpo da requisição: " + req.invalidJson));
                return;
            }

            var options = { method: req.method, headers: req.headers };
            if (req.hasBody) {
                options.body = JSON.stringify(req.body);
            }

            $responseBox.show().empty().append($("<pre>").text("Enviando..."));
            fetch(req.url, options)
                .then(function(res){ return res.text().then(function(text){ return { status: res.status, text: text }; }); })
                .then(function(result){
                    $responseBox.empty();
                    $responseBox.append(
                        $("<div>").addClass("responseStatus " + (result.status >= 400 ? "error" : "ok")).text("HTTP " + result.status)
                    );

                    try {
                        var parsed = JSON.parse(result.text);
                        var formatter = new JSONFormatter(parsed, 2);
                        $responseBox.append(formatter.render());
                    } catch(err) {
                        $responseBox.append($("<pre>").text(result.text));
                    }
                })
                .catch(function(err){
                    $responseBox.empty().append($("<pre>").text("Erro ao enviar requisição: " + err.message));
                });
        });

        // Copiar cURL: mesma montagem de request, só transforma em comando em vez de enviar.
        $(document).on("click", ".copyCurlBtn", function(){
            var $form = $(this).closest(".requestPlayground").find(".playgroundForm");
            var req = buildPlaygroundRequest($form);

            if (req.invalidJson) {
                swal("JSON inválido", "Corrija o corpo da requisição antes de copiar: " + req.invalidJson, "error", {
                    buttons: false, timer: 2500
                });
                return;
            }

            pg.copyToClipboard(buildCurlCommand(req));
            swal("cURL copiado!", "Comando cURL copiado para área de transferência", "success", {
                buttons: false,
                closeOnClickOutside: false,
                closeOnEsc: false,
                timer: 2500
            });
        });
    </script>
</body>
</html>
