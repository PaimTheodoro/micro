                                        <?= htmlspecialchars($child['type']) ?>
                                    </div>
                                    <?php if (isset($child['required']) && $child['required'] === TRUE): ?>
                                        <div class="col-auto requiredField">OBRIGATÓRIO</div>
                                    <?php endif; ?>
                                    <?php if (isset($child['description']) && !empty($child['description'])): ?>
                                        <div class="col-auto ml-auto descriptionField">
                                            <?= $child['description'] ?>
                                        </div>
                                    <?php endif; ?>
                                </div>
                            </div>
                        </div>
                    <?php endforeach; ?>
                </div>
            </div>
