<div class="row">
    <div class="col itemFinal">
        <div class="row">
            <div class="col-auto nameField">
                <?= htmlspecialchars($field['name']) ?>
            </div>
            <div class="col-auto typeField">
                <?= htmlspecialchars($field['type']) ?>
            </div>

            <?php if (isset($field['required']) && $field['required'] === TRUE): ?>
                <div class="col-auto requiredField">OBRIGATÓRIO</div>
            <?php endif; ?>

            <?php if (isset($field['description']) && !empty($field['description'])): ?>
                <div class="col-auto ml-auto descriptionField">
